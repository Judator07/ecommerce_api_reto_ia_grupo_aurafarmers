# Plantilla de variables para docker compose.
# Cópiala a .env y cambia los valores:
#   cp .env.example .env
# .env contiene secretos: NUNCA se sube a git (ya está en .gitignore).
#
# ADVERTENCIA: las contraseñas NO deben contener @ : / (ni # ? % $ o espacios),
# porque rompen la URL de conexión DATABASE_URL. Usa letras, números, _ y -.

MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
MYSQL_DATABASE=ecommerce_db
MYSQL_USER=ecommerce
MYSQL_PASSWORD=cambia_esta_clave

# Para ejecutar la API fuera de Docker con SQLite (exporta la variable en tu shell;
# docker compose no la usa, construye su propia DATABASE_URL hacia MySQL):
# DATABASE_URL=sqlite:///./dev.db
